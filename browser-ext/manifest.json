{
  "manifest_version": 3,
  "name": "CutCut 抠图",
  "short_name": "CutCut",
  "version": "1.0.0",
  "description": "在网页图片上右键，直接用本机 CutCut 抠出主体（离线运行，图片不出本机）。",
  "minimum_chrome_version": "96",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CutCut 抠图",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "key": ""
}
